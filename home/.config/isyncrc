# mbsync: pull iCloud mail into a local maildir.
#
# mbsync 1.5 reads $XDG_CONFIG_HOME/isyncrc first, then ~/.mbsyncrc. So this
# file must sit at ~/.config/isyncrc, not ~/.config/isync/mbsyncrc.
#
# Apple forces two factor auth, so a normal password never works over IMAP.
# Make an app specific password at appleid.apple.com, store it in Bitwarden,
# and rbw hands it over here. No secret lands on disk.

IMAPAccount icloud
Host imap.mail.me.com
Port 993
# Apple documents the name part for icloud.com addresses. A full address works
# for many @me.com accounts. Swap to "cameron.austgen" if auth fails.
User cameron.austgen
# tr strips whitespace. Apple shows the app password as xxxx-xxxx-xxxx-xxxx,
# and a copy and paste easily carries a leading space or a trailing newline.
# The server then answers AUTHENTICATIONFAILED, which reads like a wrong
# password. Both the dashed and the undashed form authenticate.
PassCmd "rbw get 'iCloud app password' | tr -d '[:space:]'"
TLSType IMAPS
TLSVersions +1.2 +1.3
# Homebrew builds isync against the macOS system SASL, and no cyrus-sasl comes
# with it. Without an explicit mechanism, mbsync stops with "Unable to find a
# callback: 18944" before it ever sends the password. LOGIN skips SASL, and
# TLS already protects the exchange. iCloud advertises PLAIN, and that works
# too, but it goes back through the same SASL layer.
AuthMechs LOGIN
# Apple drops connections that open too many streams at once.
PipelineDepth 1

IMAPStore icloud-remote
Account icloud

MaildirStore icloud-local
Path ~/Mail/icloud/
Inbox ~/Mail/icloud/INBOX
# iCloud folder names carry spaces, such as "Sent Messages". Verbatim keeps
# them as they are, so aerc and the web client agree.
SubFolders Verbatim

Channel icloud
Far :icloud-remote:
Near :icloud-local:
# Notes is not mail. It shows over IMAP, and it only adds noise here.
Patterns * !"Notes"
Create Both
Expunge Both
SyncState *

# ---------------------------------------------------------------------------
# Personal Gmail
# ---------------------------------------------------------------------------
# Gmail advertises AUTH=XOAUTH2, AUTH=PLAIN and AUTH=OAUTHBEARER, but not
# AUTH=LOGIN. So this uses PLAIN, unlike the iCloud block above.
#
# Google needs an app password, made at myaccount.google.com/apppasswords with
# two step verification on. Store it in Bitwarden as "Gmail app password".

IMAPAccount gmail
Host imap.gmail.com
Port 993
User cameron.austgen@gmail.com
PassCmd "rbw get 'Gmail app password' | tr -d '[:space:]'"
TLSType IMAPS
TLSVersions +1.2 +1.3
AuthMechs PLAIN

IMAPStore gmail-remote
Account gmail

MaildirStore gmail-local
Path ~/Mail/gmail/
Inbox ~/Mail/gmail/INBOX
SubFolders Verbatim

Channel gmail
Far :gmail-remote:
Near :gmail-local:
# Gmail uses labels, so every message also sits in "All Mail". Syncing that
# folder downloads the whole mailbox a second time. Important and Starred are
# views of other mail, so they duplicate as well.
Patterns * !"[Gmail]/All Mail" !"[Gmail]/Important" !"[Gmail]/Starred"
Create Both
Expunge Both
SyncState *

# ---------------------------------------------------------------------------
# AngelList, Google Workspace
# ---------------------------------------------------------------------------
# Same servers as Gmail, because angellist.com runs Google Workspace. Its MX
# records point at aspmx.l.google.com.
#
# A Workspace tenant can switch app passwords off. If auth fails and
# myaccount.google.com/apppasswords refuses to load, the account needs OAuth2
# instead, and that needs a Google Cloud client of your own.

IMAPAccount angellist
Host imap.gmail.com
Port 993
User caustgen@angellist.com
PassCmd "rbw get 'AngelList app password' | tr -d '[:space:]'"
TLSType IMAPS
TLSVersions +1.2 +1.3
AuthMechs PLAIN

IMAPStore angellist-remote
Account angellist

MaildirStore angellist-local
Path ~/Mail/angellist/
Inbox ~/Mail/angellist/INBOX
SubFolders Verbatim

Channel angellist
Far :angellist-remote:
Near :angellist-local:
Patterns * !"[Gmail]/All Mail" !"[Gmail]/Important" !"[Gmail]/Starred"
Create Both
Expunge Both
SyncState *
