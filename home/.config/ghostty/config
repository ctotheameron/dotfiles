# https://ghostty.org/docs/config/reference

title = Ghostty

###################
## Window / macOS #
###################
macos-titlebar-style = hidden
macos-window-shadow = false
window-decoration = false
window-save-state = always
window-theme = auto

################
## UI / visuals
################
theme = Catppuccin Mocha
background-opacity = 0.85
background-blur-radius = 40
bold-is-bright = true
mouse-hide-while-typing = true
window-padding-balance = true
window-padding-x = 16
window-padding-y = 10

font-family = "Liga SFMono Nerd Font"
font-size = 16
# Fallback for icons/symbols — ghostty usually finds these automatically,
# only uncomment if glyphs render as boxes:
# font-family = "Symbols Nerd F Mono"

####################
## Quick terminal ##
####################

# ⌘+/ drops a terminal down from the top of the screen (like iTerm hotkey window)
keybind = super+slash=toggle_quick_terminal
quick-terminal-position = top

###############
## Clipboard ##
###############
clipboard-read = "allow"
clipboard-write = "allow"
clipboard-trim-trailing-spaces = true

#################
## Keybindings ##
#################

# Make left Option behave as Alt so terminal apps receive M-<key> sequences
macos-option-as-alt = true

# --- How the `text:` bindings below work -----------------------------------
#
# `keybind = super+X=text:...` makes ⌘+X type a raw byte sequence into the
# terminal. This lets macOS-native shortcuts drive tmux and neovim:
#
#   \x02  = Ctrl-B        → the tmux prefix; \x02 followed by a letter is
#                           "prefix+letter", i.e. a tmux binding (see
#                           ~/.config/tmux/tmux.conf for what each one does)
#   \x3a  = ":"           → starts a vim/neovim command; the bytes after it
#                           spell out the command, ending with \x0a (Enter)
#   \x0a  = Enter/Return
#   \x1b  = Escape        → \x1b followed by a letter is "Alt+letter" (M-key)
#
# e.g. super+t=text:\x02\x63 means: ⌘T sends prefix+c → tmux opens a new
# window — so ⌘T "opens a tab" just like a native mac app.
# ----------------------------------------------------------------------------

# ⌘+j → sends Alt+j; caught by tmux (M-j binding) inside tmux, or by the zsh
# _sesh_picker widget outside tmux. Either way: opens the sesh session picker.
keybind = super+j=text:\x1bj

# ⌘+z → prefix+z : toggle zoom (full-screen) for the current tmux pane
# (shadows native Undo in the terminal — z/u in shells is rarely missed)
keybind = super+z=text:\x02\x7a

# --- ⌘+1-9 → tmux window switching (prefix+1..9) ---------------------------
# "physical:" means the physical key position, so it works on any keyboard
# layout. Uncomment to make ⌘+number jump to that tmux window:
# keybind = super+physical:one=text:\x021
# keybind = super+physical:two=text:\x022
# keybind = super+physical:three=text:\x023
# keybind = super+physical:four=text:\x024
# keybind = super+physical:five=text:\x025
# keybind = super+physical:six=text:\x026
# keybind = super+physical:seven=text:\x027
# keybind = super+physical:eight=text:\x028
# keybind = super+physical:nine=text:\x029

# --- ⌘+letter → tmux / neovim actions ---------------------------------------
# ⌘C → prefix+[ : enter tmux copy mode (WARNING: shadows native copy; you'd copy with `y` in copy-mode instead)
# keybind = super+c=text:\x02[

# ⌘L → prefix+L : switch to last sesh session (tmux.conf: bind L)
keybind = super+l=text:\x02\x4c

# ⌘N → prefix+% : tmux vertical split ("new pane")
keybind = super+n=text:\x02\x25

#
# ⌘O → prefix+u : tmux-fzf-url — pick & open a URL from the scrollback
# keybind = super+o=text:\x02\x75
#
# ⌘T → prefix+c : new tmux window (native-feeling "new tab")
# keybind = super+t=text:\x02\x63
#
# ⌘W → prefix+x : kill current tmux pane (native-feeling "close tab";
#                 tmux.conf binds x without the y/n confirm prompt)
# keybind = super+w=text:\x02\x78

# --- ⌘+Shift+letter ----------------------------------------------------------
# ⌘⇧K → prefix+R : sesh root-session picker (tmux.conf: bind R)
# keybind = super+shift+k=text:\x02\x52
#
# ⌘⇧O → types ":GoToSymbol<Enter>" in neovim: symbol picker (like VS Code ⌘⇧O)
# keybind = super+shift+o=text:\x3a\x47\x6f\x54\x6f\x53\x79\x6d\x62\x6f\x6c\x0a

# --- ⌘+brackets → navigation -------------------------------------------------
# ⌘⇧[ / ⌘⇧] → prefix+n / prefix+p : next / previous tmux window
keybind = super+shift+left_bracket=text:\x02\x6e
keybind = super+shift+right_bracket=text:\x02\x70

# --- Free keys (ideas, nothing bound) --------------
# super+a (select all?)   super+b (build?)      super+d   super+e
# super+h (hide?)         super+i               super+m (minimize?)
# super+u                 super+v (paste)       super+x (cut)
# super+y                 super+shift+j (secondary sesh)
# super+shift+w (undo close?)                   super+shift+z (redo?)
