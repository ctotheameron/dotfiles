#!/usr/bin/env bash
# Default sesh startup command (wired in sesh.toml [default_session]).
#
#   1. If the project has a `.sesh` script, run it.
#   2. Otherwise, in git repos, offer to scaffold one from sesh.example —
#      prompting for the three right-side pane commands (top to bottom).
#      Declining is remembered (per repo, in $DECLINED) and never asks again.
#   3. Otherwise, just open nvim.
#
# To make a repo prompt again: remove its line from $DECLINED.
set -u

TEMPLATE="$HOME/.config/sesh/sesh.example"
DECLINED="${XDG_STATE_HOME:-$HOME/.local/state}/sesh/declined"

if [ -f ./.sesh ]; then
  exec bash ./.sesh
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"

if [ -n "$repo_root" ] && [ -f "$TEMPLATE" ] &&
  ! grep -qxF "$repo_root" "$DECLINED" 2>/dev/null; then
  printf 'No .sesh in this repo. Scaffold the editor + 3-pane template? [y/N] '
  read -r reply
  if [[ "$reply" == [Yy]* ]]; then
    printf 'Commands for the right-side panes (top to bottom, empty = plain shell):\n'
    read -r -p '  top    ❯ ' top_cmd
    read -r -p '  middle ❯ ' mid_cmd
    read -r -p '  bottom ❯ ' bot_cmd
    {
      printf '#!/usr/bin/env bash\n'
      printf '# Generated by sesh-startup. Tweak commands freely; the layout\n'
      printf '# below is copied from %s\n' "$TEMPLATE"
      printf 'right_width=80 # columns\n'
      printf 'top_cmd=%q\n' "$top_cmd"
      printf 'mid_cmd=%q\n' "$mid_cmd"
      printf 'bot_cmd=%q\n' "$bot_cmd"
      printf '\n'
      sed -n '/^# --- layout/,$p' "$TEMPLATE"
    } >.sesh
    chmod +x .sesh
    exec bash ./.sesh
  else
    # Remember the decline so this repo never prompts again
    mkdir -p "$(dirname "$DECLINED")"
    printf '%s\n' "$repo_root" >>"$DECLINED"
  fi
fi

exec nvim .
