#!/bin/bash
#
# Omarchy post-update hook: flag dotfiles drift caused by migrations.
# Omarchy migrations patch ~/.config files with `sed -i`/`cp`. Through a stow
# folded-dir symlink those writes land in the repo working tree (show up as
# `git status` changes); on an unfolded symlink they sever it. dotfiles-doctor
# reports both and never auto-reverts. Review with `git -C ~/Projects/dotfiles
# diff`, then commit/restore, or run `dotfiles-doctor --fix` to re-link.
#
command -v dotfiles-doctor >/dev/null || exit 0

if ! dotfiles-doctor --quiet; then
  command -v notify-send >/dev/null &&
    notify-send -u critical "dotfiles-doctor" \
      "Omarchy update changed stow-managed config. Run: dotfiles-doctor"
fi
exit 0
