# Catppuccin Mocha for aerc.
#
# aerc ships a styleset called "catppuccin", but its colours are Frappé
# (#c6d0f5 text on #303446). The rest of the terminal tools here use Mocha,
# so this file maps the same slots onto the Mocha palette.
#
# base #1e1e2e   mantle #181825   crust #11111b
# surface0 #313244   surface1 #45475a   surface2 #585b70
# overlay0 #6c7086   overlay1 #7f849c   overlay2 #9399b2
# subtext0 #a6adc8   subtext1 #bac2de   text #cdd6f4

*.default=true
*.normal=true

default.fg=#cdd6f4

error.fg=#f38ba8
warning.fg=#fab387
success.fg=#a6e3a1

tab.fg=#6c7086
tab.bg=#181825
tab.selected.fg=#cdd6f4
tab.selected.bg=#1e1e2e
tab.selected.bold=true

border.fg=#313244
border.bold=true

msglist_unread.bold=true
msglist_flagged.fg=#f9e2af
msglist_flagged.bold=true
msglist_result.fg=#89b4fa
msglist_result.bold=true
msglist_*.selected.bold=true
msglist_*.selected.bg=#45475a

dirlist_*.selected.bold=true
dirlist_*.selected.bg=#45475a

statusline_default.fg=#bac2de
statusline_default.bg=#45475a
statusline_error.bold=true
statusline_success.bold=true

completion_default.selected.bg=#45475a

part_filename.selected.fg=#cdd6f4
part_filename.selected.bg=#1e1e2e
part_switcher.selected.bg=#1e1e2e

part_mimetype.selected.fg=#cdd6f4
part_mimetype.selected.bg=#1e1e2e

selector_focused.bg=#1e1e2e

[viewer]
url.fg=#89b4fa
url.underline=true
header.bold=true
signature.dim=true
diff_meta.bold=true
diff_chunk.fg=#89b4fa
diff_chunk_func.fg=#89b4fa
diff_chunk_func.bold=true
diff_add.fg=#a6e3a1
diff_del.fg=#f38ba8
diff_whitespace.bg=#f38ba8
quote_*.fg=#6c7086
quote_1.fg=#9399b2
