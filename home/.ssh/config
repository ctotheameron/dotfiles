# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config


# Multiplex SSH to GitHub — the first connection authenticates (one
# Bitwarden approval) and stays open in the background for 4 hours after
# the last use (ControlPersist). Later git fetch/push reuse it and skip
# the agent, so no approval popup per operation. %C is a short hash of
# user+host+port for the socket file name.
Host github.com
  ControlMaster auto
  ControlPath ~/.ssh/cm-%C
  ControlPersist 4h

# Bitwarden SSH agent — keys live in the Bitwarden vault, served via this
# socket. Same path on macOS and Linux (non-flatpak).
Host *
  IdentityAgent ~/.bitwarden-ssh-agent.sock
