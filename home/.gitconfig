[user]
	name = Cameron Austgen
	email = 3002968+ctotheameron@users.noreply.github.com
	# Public half of the signing key; the private half lives in the 1Password
	# SSH agent (SSH_AUTH_SOCK exported in zsh/ssh.zsh). GitHub holds it as the
	# signing key "caustgen@angellist.com".
	signingkey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICg/0ffK+FqNCt5rIA+0XTYZ7s52ZfSDp58JVtYCe2Ts

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
	# Sign every commit with the key above, through the 1Password agent.
	gpgsign = true

# Machine-local overrides (untracked; optional). Work identity, work-org
# includeIf/insteadOf rules, etc. live here — keep them out of this repo.
[include]
	path = ~/.gitconfig.local

# Catppuccin theme for delta (https://github.com/catppuccin/delta);
# mocha to match ghostty + lazygit
[include]
	path = ~/.config/delta/catppuccin.gitconfig
[delta]
	features = catppuccin-mocha

[core]
	editor = nvim
