[user]
	name = Cameron Austgen
	email = 3002968+ctotheameron@users.noreply.github.com
	# Signing-only key file on disk (private half: ~/.ssh/github_signing).
	# GitHub holds the public half as a "Signing Key". Login keys stay in the
	# Bitwarden agent; signing skips the agent on purpose — the agent shows one
	# approval popup per signature, which means one popup per rewritten commit
	# on every rebase/restack.
	signingkey = ~/.ssh/github_signing.pub

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
	# Sign every commit with the key file above. No agent is involved.
	gpgsign = true

# Machine-local overrides (untracked; optional). Work identity, work-org
# includeIf/insteadOf rules, etc. live here — keep them out of this repo.
[include]
	path = ~/.gitconfig.local

# Catppuccin theme for delta (https://github.com/catppuccin/delta);
# mocha to match ghostty + lazygit
[include]
	path = ~/.config/delta/catppuccin.gitconfig
[delta]
	features = catppuccin-mocha

[core]
	editor = nvim
