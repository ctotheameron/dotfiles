#!/usr/bin/env bash
#
# dotfiles-doctor — detect drift between the dotfiles repo and $HOME.
#
# Model: configs are stowed into $HOME. GNU stow may FOLD a whole directory
# into a single symlink, so a file like ~/.config/bat/config is a real file
# reached *through* a parent-dir symlink — it is healthy even though the file
# itself is not a symlink. Health is therefore decided by canonical resolution:
# a target is healthy iff `readlink -f` lands inside the repo (this covers both
# per-file symlinks and folded-directory symlinks).
#
# Omarchy migrations (`omarchy-update`) patch live config with `sed -i`/`cp`.
# Inside a folded dir those writes land in the repo working tree and show up as
# ordinary `git status` changes (the primary drift signal below). On an
# UNfolded per-file symlink, `sed -i` severs the link into a standalone real
# file — that is what this reports as "severed".
#
#   dotfiles-doctor          # report drift (exit non-zero if any)
#   dotfiles-doctor --quiet  # only print/exit-nonzero when there IS drift
#   dotfiles-doctor --fix    # re-link severed/foreign targets (never touches
#                            #   anything that resolves into the repo)
#
set -uo pipefail

# Default to the repo this (stowed) script lives in: <repo>/home/.local/bin
DOTFILES_DIR="${DOTFILES_DIR:-"$(cd "$(dirname "$(realpath "$0")")/../../.." && pwd)"}"
FIX=0
QUIET=0
for a in "$@"; do
  case "$a" in
    --fix) FIX=1 ;;
    --quiet) QUIET=1 ;;
    -h | --help)
      sed -n '3,20p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "dotfiles-doctor: unknown arg '$a'" >&2
      exit 2
      ;;
  esac
done

[ -d "$DOTFILES_DIR" ] || { echo "dotfiles-doctor: $DOTFILES_DIR not found" >&2; exit 2; }
DOTFILES_REAL="$(readlink -f "$DOTFILES_DIR")"

# Stow packages that apply on this OS (mirror install.sh).
pkgs=(home)
case "$(uname -s)" in
  Darwin) pkgs+=(macos) ;;
  Linux) [ -d "$DOTFILES_DIR/arch" ] && pkgs+=(arch) ;;
esac

# Healthy iff the path canonically resolves to somewhere inside the repo. This
# follows EVERY symlink on the way (including a folded parent directory), which
# is exactly why it does not false-flag files inside a folded dir. It is also
# the safety predicate for --fix: a true result means "do not touch".
under_repo() {
  local real
  real="$(readlink -f "$1" 2>/dev/null)" || return 1
  [ -n "$real" ] && [[ "$real" == "$DOTFILES_REAL"/* ]]
}

broken=()   # exists at target but resolves OUTSIDE the repo (severed file or foreign link)
unlinked=() # tracked by the repo but nothing usable at the target

for pkg in "${pkgs[@]}"; do
  [ -d "$DOTFILES_DIR/$pkg" ] || continue
  while IFS= read -r rel; do
    rel="${rel#./}"
    tgt="$HOME/$rel"
    if [ -L "$tgt" ] || [ -e "$tgt" ]; then
      # Resolve ancestor symlinks too: stow can fold a whole directory into
      # one link, leaving healthy files that aren't symlinks themselves.
      case "$(readlink -f "$tgt" 2>/dev/null)" in
        "$DOTFILES_DIR"/*) : ;; # healthy
        *)
          if [ -L "$tgt" ]; then
            foreign+=("$rel")
          else
            broken+=("$rel") # real file where a symlink should be
          fi
          ;;
      esac
    else
      unlinked+=("$rel")
    fi
  # No -printf: BSD find lacks it; the ${rel#./} strip above covers both.
  done < <(cd "$DOTFILES_DIR/$pkg" && find . \( -type f -o -type l \))
done

problems=${#broken[@]}

# Primary drift signal: migrations that write THROUGH a (folded) symlink land in
# the repo working tree as ordinary git changes. This is how write-through edits
# surface, so it counts as drift too (the post-update hook relies on it).
gitout="$(git -C "$DOTFILES_DIR" status --short 2>/dev/null)"

report() {
  if ((${#broken[@]})); then
    echo "✗ not linked to the repo (severed by a migration, or a foreign symlink):"
    for rel in "${broken[@]}"; do
      tgt="$HOME/$rel"
      if [ -L "$tgt" ]; then
        printf '    ~/%s  ->  %s\n' "$rel" "$(readlink "$tgt")"
      else
        printf '    ~/%s  (real file — symlink severed)\n' "$rel"
      fi
    done
  fi
  if [ -n "$gitout" ]; then
    echo "• uncommitted changes in $DOTFILES_DIR (review with 'git diff', then commit or restore):"
    echo "$gitout" | sed 's/^/    /'
  fi
}

# Drift = broken symlinks OR repo-side changes. Keeping the repo committed makes
# this signal clean, so an omarchy update that edits config stands out.
drift=0
((problems)) && drift=1
[ -n "$gitout" ] && drift=1

if ((drift == 0)); then
  ((QUIET)) || echo "dotfiles-doctor: ✓ symlinks healthy and repo clean (${#unlinked[@]} tracked paths not linked)"
  exit 0
fi

if ((QUIET)); then
  # Terse one-liner so the post-update hook has something to log, then exit
  # non-zero to trigger its notification.
  msg="dotfiles-doctor: drift detected —"
  ((problems)) && msg+=" $problems severed/foreign symlink(s);"
  [ -n "$gitout" ] && msg+=" uncommitted repo changes;"
  echo "${msg%;}"
  exit 1
fi

((problems)) && echo "dotfiles-doctor: found $problems symlink issue(s)"
report

if ((problems > 0)); then
  if ((FIX)); then
    ts="$(date +%Y%m%d-%H%M%S)"
    backup="$HOME/.dotfiles-backup/doctor-$ts"
    echo
    echo "→ backing up severed/foreign targets to $backup and re-stowing…"
    for rel in "${broken[@]}"; do
      tgt="$HOME/$rel"
      # SAFETY NET: never move a path that resolves into the repo. Without this,
      # `mv` would follow a folded parent-dir symlink and yank the file straight
      # out of the repo. `broken` should never contain such a path, but assert it.
      if under_repo "$tgt"; then
        echo "  ⚠ skip ~/$rel — resolves into the repo (folded dir), refusing to touch"
        continue
      fi
      mkdir -p "$backup/$(dirname "$rel")"
      mv "$tgt" "$backup/$rel"
    done
    stow -d "$DOTFILES_DIR" -t "$HOME" --restow "${pkgs[@]}"
    echo "✓ re-stowed. Compare the backup against the repo to fold in any wanted"
    echo "  migration changes:  diff -ru $backup ~/<path>"
  else
    echo
    echo "Re-link with:  dotfiles-doctor --fix   (backs up the severed files first)"
  fi
elif [ -n "$gitout" ]; then
  # No symlink problems — the only drift is repo-side. Nothing to re-stow; the
  # user reviews and commits or restores. --fix has nothing to do here.
  echo
  echo "No symlinks to re-link — this is repo-side drift. Review and commit or restore."
fi
exit 1
