#!/usr/bin/env bash
#
# dotfiles-doctor — detect drift between the dotfiles repo and $HOME.
#
# The main thing it catches: Omarchy migrations (run by `omarchy-update`) patch
# live config files with `sed -i` / `cp`, which can replace a stow symlink with
# a plain file (severing it from the repo) or write changes through into the
# repo. This reports those so they don't silently rot.
#
#   dotfiles-doctor          # report drift (exit non-zero if any)
#   dotfiles-doctor --quiet  # only print/exit-nonzero when there IS drift
#   dotfiles-doctor --fix    # back up offending real files, then re-stow
#
set -uo pipefail

# Default to the repo this (stowed) script lives in: <repo>/home/.local/bin
DOTFILES_DIR="${DOTFILES_DIR:-"$(cd "$(dirname "$(realpath "$0")")/../../.." && pwd)"}"
FIX=0
QUIET=0
for a in "$@"; do
  case "$a" in
    --fix) FIX=1 ;;
    --quiet) QUIET=1 ;;
    -h | --help)
      sed -n '3,14p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "dotfiles-doctor: unknown arg '$a'" >&2
      exit 2
      ;;
  esac
done

[ -d "$DOTFILES_DIR" ] || { echo "dotfiles-doctor: $DOTFILES_DIR not found" >&2; exit 2; }

# Stow packages that apply on this OS (mirror install.sh).
pkgs=(home)
case "$(uname -s)" in
  Darwin) pkgs+=(macos) ;;
  Linux) [ -d "$DOTFILES_DIR/arch" ] && pkgs+=(arch) ;;
esac

broken=() # exists in $HOME as a real file where a repo symlink is expected
foreign=() # symlink, but not pointing into the repo
unlinked=() # tracked by repo but nothing at the target

for pkg in "${pkgs[@]}"; do
  [ -d "$DOTFILES_DIR/$pkg" ] || continue
  while IFS= read -r rel; do
    rel="${rel#./}"
    tgt="$HOME/$rel"
    if [ -L "$tgt" ] || [ -e "$tgt" ]; then
      # Resolve ancestor symlinks too: stow can fold a whole directory into
      # one link, leaving healthy files that aren't symlinks themselves.
      case "$(readlink -f "$tgt" 2>/dev/null)" in
        "$DOTFILES_DIR"/*) : ;; # healthy
        *)
          if [ -L "$tgt" ]; then
            foreign+=("$rel")
          else
            broken+=("$rel") # real file where a symlink should be
          fi
          ;;
      esac
    else
      unlinked+=("$rel")
    fi
  # No -printf: BSD find lacks it; the ${rel#./} strip above covers both.
  done < <(cd "$DOTFILES_DIR/$pkg" && find . \( -type f -o -type l \))
done

problems=$((${#broken[@]} + ${#foreign[@]}))

report() {
  if ((${#broken[@]})); then
    echo "✗ replaced by real files (symlink severed — likely an Omarchy migration):"
    printf '    ~/%s\n' "${broken[@]}"
  fi
  if ((${#foreign[@]})); then
    echo "✗ symlinks pointing outside the repo:"
    printf '    ~/%s\n' "${foreign[@]}"
  fi
  # Repo-side drift (e.g. a migration appended/cp'd through a live symlink).
  local gitout
  gitout="$(git -C "$DOTFILES_DIR" status --short 2>/dev/null)"
  if [ -n "$gitout" ]; then
    echo "• uncommitted changes in $DOTFILES_DIR:"
    echo "$gitout" | sed 's/^/    /'
  fi
}

if ((problems == 0)); then
  ((QUIET)) || echo "dotfiles-doctor: ✓ all managed symlinks healthy (${#unlinked[@]} tracked paths not linked)"
  exit 0
fi

echo "dotfiles-doctor: found $problems symlink issue(s)"
report

if ((FIX)); then
  ts="$(date +%Y%m%d-%H%M%S)"
  backup="$HOME/.dotfiles-backup/doctor-$ts"
  echo
  echo "→ backing up severed files to $backup and re-stowing…"
  for rel in "${broken[@]}"; do
    mkdir -p "$backup/$(dirname "$rel")"
    mv "$HOME/$rel" "$backup/$rel"
  done
  stow -d "$DOTFILES_DIR" -t "$HOME" --restow "${pkgs[@]}"
  echo "✓ re-stowed. Compare the backup against the repo to fold in any wanted"
  echo "  migration changes:  diff -ru $backup ~/<path>"
else
  echo
  echo "Fix with:  dotfiles-doctor --fix   (backs up the changed files first)"
fi
exit 1
