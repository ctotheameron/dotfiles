.DS_Store

# Never commit credentials
home/.config/gh/hosts.yml

# pi: only settings.json is tracked. Credentials and machine state live as
# real files in ~/.pi/agent/ — keep them out even if adopted/copied here
home/.pi/agent/auth.json
home/.pi/agent/models-store.json
home/.pi/agent/npm/
home/.pi/agent/sessions/
home/.pi/agent/*-memory/
home/.pi/agent/*.sqlite
home/.pi/agent/*-state.json

# Work-specific config stays local
home/.config/zsh/work.zsh
home/.config/git/work.gitconfig
packages/Brewfile.local

# opencode installs these locally from package.json
home/.config/opencode/node_modules/

# lazygit machine-local state (recent repos, window state)
home/.config/lazygit/state.yml

# tpm manages these clones; tpm install_plugins restores them
home/.config/tmux/plugins/
